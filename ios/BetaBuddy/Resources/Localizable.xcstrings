    "删除原片、分析和笔记？此操作无法撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the video, analysis and notes? This can’t be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画、解析、メモを削除しますか？この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상, 분석, 메모를 삭제할까요? 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除原片、分析和笔记？此操作无法撤销。"
          }
        },
