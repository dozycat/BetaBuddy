            "state": "translated",
            "value": "このビルドには\nジムのデータがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는\n암장 데이터가 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个构建没有\n内置岩馆数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本沒有\n內建岩館資料"
