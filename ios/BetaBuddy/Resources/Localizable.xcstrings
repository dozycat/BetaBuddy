    "这里没有认出岩点。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No hold was recognised here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはホールドが認識されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 홀드를 인식하지 못했어요."
          }
        },
