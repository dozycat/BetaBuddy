    },
    "仍然可以从相册导入拍好的视频。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still import a video you already shot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影済みの動画は「写真」から読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 찍은 영상은 사진에서 가져올 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然可以从相册导入拍好的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然可以從「照片」匯入拍好的影片。"
          }
        }
      }
    },
    "手机放稳，去爬吧。爬完回来点停止。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the phone where it stands and go climb. Tap stop when you are back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末はそのままにして、登ってきてください。戻ったら停止をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기는 그대로 두고 등반하세요. 돌아와서 정지를 누르면 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机放稳，去爬吧。爬完回来点停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機放穩，去爬吧。爬完回來點停止。"
          }
        }
      }
    },
