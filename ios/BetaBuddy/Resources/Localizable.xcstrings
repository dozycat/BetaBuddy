      }
    },
    "香蕉嘉里与攀爬册免费使用；更多岩馆需终生会员解锁。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "香蕉嘉里与攀爬册免费使用；更多岩馆需终生会员解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "香蕉嘉里與攀爬冊免費使用；更多岩館需終生會員解鎖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BANANA+ Kerry and Logbook are free. Lifetime membership unlocks additional gyms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BANANA+ ケリーとクライムログは無料です。追加のジムは永久メンバーシップで利用できます。"
          }
