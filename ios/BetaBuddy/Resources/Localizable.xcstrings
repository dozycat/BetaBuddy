    "二维姿态辅助回看；候选动作未经人工确认。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2D pose estimate for review only; cues have not been checked by a person."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 次元の姿勢推定による振り返り用です。候補のムーブは人の目で確認していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2차원 자세 추정을 이용한 복기용입니다. 후보 동작은 사람이 확인하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维姿态辅助回看；候选动作未经人工确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二維姿態輔助回看；候選動作未經人工確認。"
          }
        }
      }
    },
