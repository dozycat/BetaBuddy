          "stringUnit": {
            "state": "translated",
            "value": "Allow BetaBuddy to use the camera in Settings to record here. The picture and the recording stay on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で BetaBuddy にカメラの使用を許可すると、ここで撮影できます。映像と録画はこの iPhone の中だけに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 BetaBuddy의 카메라 사용을 허용하면 여기서 촬영할 수 있어요. 화면과 녹화본은 이 iPhone에만 남아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置里允许 BetaBuddy 使用相机，就能在这里拍。画面和录像只留在这台 iPhone 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定裡允許 BetaBuddy 使用相機，就能在這裡拍。畫面和錄影只留在這支 iPhone 上。"
          }
        }
      }
    },
    "这台设备没有可用的相机": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no camera to use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには使えるカメラがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 사용할 수 있는 카메라가 없어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
