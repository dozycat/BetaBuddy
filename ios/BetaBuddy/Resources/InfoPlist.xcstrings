{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a climbing video to analyze on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライミング動画を選び、この iPhone で動きを解析します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등반 영상을 선택해 이 iPhone에서 동작을 분석합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择攀爬视频，在这台 iPhone 上分析动作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇攀爬影片，在這支 iPhone 上分析動作。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your climb, check the camera position and save it on this iPhone. The recording stays on this device unless you share it yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライミングを撮影し、この iPhone 上でカメラ位置を確認して保存します。録画は、自分で共有しないかぎりこのデバイスの外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등반을 촬영하고, 이 iPhone에서 카메라 위치를 확인해 저장합니다. 녹화본은 직접 공유하지 않는 한 이 기기 밖으로 나가지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍下你的攀爬，在这台 iPhone 上检查机位并保存。录像只保存在这台设备上，除非你自己分享出去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍下你的攀爬，在這支 iPhone 上檢查機位並儲存。錄影只儲存在這部裝置上，除非你自己分享出去。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest nearby gyms by distance. Your location is used only on this iPhone; it is not saved and does not leave the device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのジムを距離順におすすめします。位置情報はこの iPhone 上でのみ使い、保存せず、デバイスの外にも出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가까운 암장을 거리순으로 추천합니다. 위치는 이 iPhone에서만 쓰이며, 저장하지 않고 기기 밖으로 나가지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按距离推荐附近的岩馆。位置只在这台 iPhone 上使用，不保存，也不会离开设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按距離推薦附近的岩館。位置只在這支 iPhone 上使用，不儲存，也不會離開裝置。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
