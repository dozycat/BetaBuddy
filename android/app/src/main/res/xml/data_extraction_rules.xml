<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing the app stores leaves the phone through the system: not to a cloud backup, and not in
    a phone-to-phone transfer during device setup (Android 12+ treats the two separately, and
    allowBackup="false" no longer covers the second). Videos, analysis and notes stay where they are.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
