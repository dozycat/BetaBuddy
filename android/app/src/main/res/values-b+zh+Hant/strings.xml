    <!-- Settings and About, privacy policy -->
    <string name="settings_title">設定與關於</string>
    <string name="settings_language">語言</string>
    <string name="language_follow_system">跟隨系統</string>
    <string name="about_on_device">完全在這支手機上分析</string>
    <string name="about_free">全部功能免費 · 無 App 內購買 · 無訂閱 · 無廣告</string>
    <string name="about_local">姿態模型隨安裝檔提供。不下載模型，沒有帳號，也沒有雲端 AI。匯入的影片與分析記錄儲存在 App 內，不納入系統雲端備份。</string>
    <string name="about_limits_title">分析邊界</string>
    <string name="about_limits_body">33 個關鍵點用於骨架回放與畫面內的幾何分析。角度是二維投影角度；髖部軌跡不是物理重心。遮擋、鏡頭移動、多人入鏡都會影響結果。候選片段需要對照原片確認。</string>
    <string name="about_video_requirements">適合單人、全身入鏡、固定機位的影片；單段 0.5–180 秒，最大 500 MB。建議先在相簿裡裁掉無關的片段。</string>
    <string name="about_gym_pack_line">%1$s · %2$d 條路線 · 資料版本 %3$s（%4$s）</string>
    <string name="about_gym_missing">這個版本沒有內建岩館資料。場館模型、路線和攀爬模擬隨正式安裝檔提供，不在公開原始碼裡。</string>
    <string name="about_records_title">記錄管理</string>
    <string name="about_records_body">可在每筆記錄中刪除原片和分析；移除 App 會刪除本機記錄。需要保留的複盤文字可透過分享匯出。</string>
    <string name="about_support">說明與支援</string>
    <string name="privacy_title">隱私權政策</string>
    <string name="privacy_unreadable">隱私權政策無法讀取，請重新安裝完整版本。</string>
    <string name="licenses_title">開放原始碼授權</string>
    <string name="licenses_unreadable">授權條款無法讀取，請重新安裝完整版本。</string>
</resources>
